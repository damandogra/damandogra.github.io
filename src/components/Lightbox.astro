---
import Icon from "./Icon.astro";
---

<dialog
  id="lightbox"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/85"
  aria-label="Image viewer"
>
  <div class="relative flex h-full w-full flex-col items-center justify-center gap-4 p-4 sm:p-10" data-lightbox-backdrop>
    <button
      type="button"
      data-lightbox-close
      class="absolute right-3 top-3 sm:right-6 sm:top-6 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition"
      aria-label="Close image"
    >
      <Icon name="close" class="h-5 w-5" />
    </button>
    <img id="lightbox-image" src="" alt="" class="max-h-[85vh] max-w-full rounded-lg bg-white object-contain" />
    <p id="lightbox-caption" class="max-w-3xl text-center text-sm text-white/80"></p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lightbox-image") as HTMLImageElement | null;
  const caption = document.getElementById("lightbox-caption");

  document.querySelectorAll<HTMLElement>("[data-lightbox-src]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!dialog || !img) return;
      img.src = trigger.dataset.lightboxSrc ?? "";
      img.alt = trigger.dataset.lightboxAlt ?? "";
      if (caption) caption.textContent = trigger.dataset.lightboxCaption ?? "";
      dialog.showModal();
    });
  });

  dialog?.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t === dialog || t.hasAttribute("data-lightbox-backdrop") || t.closest("[data-lightbox-close]")) {
      dialog.close();
    }
  });
  dialog?.addEventListener("close", () => {
    if (img) img.src = "";
  });
</script>
