---
import { Image, getImage } from "astro:assets";
import SocialLinks from "./SocialLinks.astro";
import Icon from "./Icon.astro";
import portrait from "../assets/portrait.jpg";
import { siteConfig } from "../config";

// Concentric "contour lines" — a nod to terrain models.
const contours = Array.from({ length: 9 }, (_, i) => 60 + i * 55);

// Source for the pixel / level-of-detail effect on the portrait.
const lod = await getImage({ src: portrait, width: 760, format: "webp" });
---

<section id="top" class="relative isolate overflow-hidden">
  <!-- Background: accent glow + grid + contours -->
  <div
    class="absolute inset-0 -z-10 opacity-70"
    style="background: radial-gradient(ellipse 900px 700px at 0% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%);"
  >
  </div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 h-full w-full stroke-line [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern id="hero-grid" width="80" height="80" x="50%" y="-1" patternUnits="userSpaceOnUse">
        <path d="M.5 80V.5H80" fill="none"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" stroke-width="0"></rect>
  </svg>
  <svg
    aria-hidden="true"
    viewBox="0 0 1000 1000"
    class="absolute -right-40 -top-40 -z-10 h-[46rem] w-[46rem] text-accent opacity-[0.12]"
  >
    {
      contours.map((r, i) => (
        <ellipse
          cx="500"
          cy="500"
          rx={r * 1.25}
          ry={r}
          transform={`rotate(${-18 + i * 3} 500 500)`}
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
      ))
    }
  </svg>

  <div
    class="container-page grid items-center gap-12 py-14 md:grid-cols-12 md:py-24 lg:py-28"
  >
    <div class="md:col-span-7 lg:col-span-7">
      <p class="animate-fade-up text-lg sm:text-xl md:text-2xl font-semibold text-ink-soft">
        Hello! <span aria-hidden="true">👋</span>
      </p>
      <h1
        class="animate-fade-up mt-4 text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-ink"
        style="animation-delay: 0.1s"
      >
        I'm <span class="text-accent">{siteConfig.name}</span>
      </h1>
      <p
        class="animate-fade-up mt-5 text-base sm:text-lg font-medium text-ink"
        style="animation-delay: 0.2s"
      >
        {siteConfig.title}
      </p>
      <p
        class="animate-fade-up mt-4 max-w-xl text-base sm:text-lg leading-relaxed text-muted"
        style="animation-delay: 0.3s"
      >
        {siteConfig.tagline}
      </p>

      <div class="animate-fade-up mt-8 flex flex-wrap items-center gap-3" style="animation-delay: 0.4s">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-90"
        >
          View projects <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>

      <div class="animate-fade-up mt-10" style="animation-delay: 0.5s">
        <SocialLinks size="lg" />
      </div>
    </div>

    <div class="md:col-span-5 lg:col-span-5 flex justify-center md:justify-end">
      <div class="animate-fade-up relative" style="animation-delay: 0.2s">
        <div
          class="absolute -inset-3 -z-10 rounded-[2rem] bg-accent-soft blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          id="portrait-lod"
          class="group relative touch-pan-y w-[240px] sm:w-[280px] md:w-[320px] lg:w-[380px] overflow-hidden rounded-[1.75rem] border border-line shadow-2xl shadow-black/20 rotate-[1.5deg] transition-transform duration-500 hover:rotate-0 cursor-crosshair"
          data-src={lod.src}
          tabindex="0"
          role="img"
          aria-label={`Painted portrait of ${siteConfig.name}. Move the cursor over it to load detail.`}
        >
          <Image
            src={portrait}
            alt=""
            widths={[320, 480, 720, 960]}
            sizes="(min-width: 1024px) 380px, (min-width: 768px) 320px, 260px"
            class="pointer-events-none block h-auto w-full select-none"
            loading="eager"
            fetchpriority="high"
          />
          <canvas class="pointer-events-none absolute inset-0 h-full w-full rounded-[1.75rem] opacity-0 transition-opacity duration-500" aria-hidden="true"></canvas>
          <span
            class="pointer-events-none absolute bottom-3 left-3 rounded-full bg-black/55 px-2.5 py-1 text-[10px] font-medium tracking-wide text-white/90 backdrop-blur transition-opacity duration-300"
            data-lod-label
            aria-hidden="true">Hover to load detail</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Portrait as a coarse raster; detail is "streamed" only around the cursor,
  // like distance-based level of detail in 3D Tiles: full resolution inside
  // the lens, a medium level in a ring around it, coarse everywhere else.
  const box = document.getElementById("portrait-lod");
  const canvas = box?.querySelector("canvas");
  const label = box?.querySelector<HTMLElement>("[data-lod-label]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (box && canvas && box.dataset.src) {
    const ctx = canvas.getContext("2d")!;
    const tmp = document.createElement("canvas");
    const tctx = tmp.getContext("2d")!;
    const img = new Image();
    img.decoding = "async";
    img.src = box.dataset.src;

    const COARSE = 10; // block size in CSS px outside the lens
    const MEDIUM = 4; // block size in the ring around the lens
    let w = 0, h = 0, dpr = 1;
    let coarse: HTMLCanvasElement, medium: HTMLCanvasElement, full: HTMLCanvasElement;

    // lens state (device px), eased towards the target every frame
    let x = 0, y = 0, r = 0;
    let tx = 0, ty = 0, tr = 0;
    let raf = 0;

    const pixelate = (block: number) => {
      const c = document.createElement("canvas");
      c.width = w;
      c.height = h;
      const cols = Math.max(4, Math.round(w / dpr / block));
      const rows = Math.max(4, Math.round(h / dpr / block));
      const s = document.createElement("canvas");
      s.width = cols;
      s.height = rows;
      s.getContext("2d")!.drawImage(img, 0, 0, cols, rows);
      const cc = c.getContext("2d")!;
      cc.imageSmoothingEnabled = false;
      cc.drawImage(s, 0, 0, cols, rows, 0, 0, w, h);
      return c;
    };

    const rebuild = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = Math.round(box.offsetWidth * dpr);
      h = Math.round(box.offsetHeight * dpr);
      canvas.width = tmp.width = w;
      canvas.height = tmp.height = h;
      coarse = pixelate(COARSE);
      medium = pixelate(MEDIUM);
      full = document.createElement("canvas");
      full.width = w;
      full.height = h;
      full.getContext("2d")!.drawImage(img, 0, 0, w, h);
      render();
    };

    const layer = (src: HTMLCanvasElement, radius: number) => {
      if (radius < 1) return;
      tctx.globalCompositeOperation = "source-over";
      tctx.clearRect(0, 0, w, h);
      tctx.drawImage(src, 0, 0);
      tctx.globalCompositeOperation = "destination-in";
      const g = tctx.createRadialGradient(x, y, radius * 0.55, x, y, radius);
      g.addColorStop(0, "rgba(0,0,0,1)");
      g.addColorStop(1, "rgba(0,0,0,0)");
      tctx.fillStyle = g;
      tctx.fillRect(0, 0, w, h);
      ctx.drawImage(tmp, 0, 0);
    };

    const render = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.drawImage(coarse, 0, 0);
      layer(medium, r * 1.9);
      layer(full, r);
    };

    const tick = () => {
      const k = reduce ? 1 : 0.18;
      x += (tx - x) * k;
      y += (ty - y) * k;
      r += (tr - r) * (reduce ? 1 : 0.1);
      render();
      if (Math.abs(tx - x) + Math.abs(ty - y) + Math.abs(tr - r) > 0.5) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
      }
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const lensRadius = () => box.offsetWidth * 0.2 * dpr;
    const moveTo = (e: PointerEvent) => {
      tx = e.offsetX * dpr;
      ty = e.offsetY * dpr;
      if (r < 1) {
        x = tx;
        y = ty;
      }
      tr = lensRadius();
      label?.classList.add("opacity-0");
      kick();
    };
    const hide = () => {
      tr = 0;
      label?.classList.remove("opacity-0");
      kick();
    };

    img.onload = () => {
      rebuild();
      canvas.style.opacity = "1";
      box.addEventListener("pointerenter", moveTo);
      box.addEventListener("pointermove", moveTo);
      box.addEventListener("pointerdown", moveTo);
      box.addEventListener("pointerleave", hide);
      box.addEventListener("pointerup", (e) => {
        if (e.pointerType !== "mouse") window.setTimeout(hide, 1200);
      });
      // keyboard: reveal the whole portrait while focused
      box.addEventListener("focus", () => {
        tx = w / 2;
        ty = h / 2;
        tr = Math.hypot(w, h);
        kick();
      });
      box.addEventListener("blur", hide);
      new ResizeObserver(rebuild).observe(box);
    };
  }
</script>
