---
import SectionHeading from "./SectionHeading.astro";
import { siteConfig } from "../config";
---

<section id="about" class="py-20 sm:py-28" aria-labelledby="about-title">
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <SectionHeading index="01" title="About Me" id="about-title" />
    </div>

    <div class="lg:col-span-8 space-y-6">
      {
        siteConfig.aboutMe.map((p, i) => (
          <p
            class={
              i === 0
                ? "text-lg sm:text-xl md:text-2xl leading-relaxed text-ink"
                : "text-base sm:text-lg leading-relaxed text-muted"
            }
          >
            {p}
          </p>
        ))
      }

      <dl class="grid gap-6 pt-6 sm:grid-cols-2">
        {
          siteConfig.skills.map((group) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{group.label}</dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <span class="rounded-full bg-surface-strong px-3 py-1.5 text-sm font-medium text-ink">
                    {skill}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
