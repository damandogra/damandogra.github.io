---
import SocialLinks from "./SocialLinks.astro";
import { siteConfig } from "../config";
---

<footer class="border-t border-line bg-surface">
  <div class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-semibold text-ink">{siteConfig.name}</p>
      <p class="mt-1 text-sm text-muted">{siteConfig.title}</p>
    </div>
    <SocialLinks />
  </div>
  <div class="container-page">
    <div class="border-t border-line py-6 text-xs text-muted flex flex-col gap-2 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {siteConfig.name}</p>
      <p>Built with Astro &amp; Tailwind CSS</p>
    </div>
  </div>
</footer>
