---
import SectionHeading from "./SectionHeading.astro";
import { siteConfig } from "../config";

const items = siteConfig.education;
---

{
  items.length > 0 && (
    <section id="education" class="py-20 sm:py-28 bg-surface" aria-labelledby="education-title">
      <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <SectionHeading index="04" title="Education" id="education-title" />
        </div>

        <div class="lg:col-span-8 space-y-6">
          {items.map((edu) => (
            <article class="rounded-2xl border border-line bg-bg p-5 sm:p-7">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <h3 class="text-lg sm:text-xl font-semibold text-ink">{edu.degree}</h3>
                <span class="shrink-0 text-xs sm:text-sm text-muted">{edu.dateRange}</span>
              </div>
              {edu.link ? (
                <a
                  href={edu.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-block text-sm sm:text-base text-accent hover:underline underline-offset-4"
                >
                  {edu.school}
                </a>
              ) : (
                <p class="mt-1 text-sm sm:text-base text-accent">{edu.school}</p>
              )}
              {edu.achievements.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {edu.achievements.map((a) => (
                    <li class="flex gap-3 text-sm sm:text-base leading-relaxed text-muted">
                      <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-muted" aria-hidden="true" />
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
