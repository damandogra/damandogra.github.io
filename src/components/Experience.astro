---
import SectionHeading from "./SectionHeading.astro";
import { siteConfig } from "../config";

const items = siteConfig.experience;
---

{
  items.length > 0 && (
    <section id="experience" class="py-20 sm:py-28" aria-labelledby="experience-title">
      <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <SectionHeading index="03" title="Experience" id="experience-title" />
        </div>

        <ol class="lg:col-span-8 relative border-l border-line ml-2 space-y-10">
          {items.map((exp, i) => (
            <li class="relative pl-8">
              <span
                class={`absolute -left-[7px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-accent ${
                  exp.dateRange.toLowerCase().includes("present") ? "bg-accent" : "bg-bg"
                }`}
                aria-hidden="true"
              />
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <h3 class="text-lg sm:text-xl font-semibold text-ink">{exp.title}</h3>
                <span class="shrink-0 text-xs sm:text-sm text-muted">{exp.dateRange}</span>
              </div>
              {exp.link ? (
                <a
                  href={exp.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-block text-sm sm:text-base text-accent hover:underline underline-offset-4"
                >
                  {exp.company}
                </a>
              ) : (
                <p class="mt-1 text-sm sm:text-base text-accent">{exp.company}</p>
              )}

              {exp.bullets.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {exp.bullets.map((b) => (
                    <li class="flex gap-3 text-sm sm:text-base leading-relaxed text-muted">
                      <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-muted" aria-hidden="true" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
