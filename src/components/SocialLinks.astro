---
import Icon from "./Icon.astro";
import { siteConfig } from "../config";

interface Props {
  size?: "sm" | "lg";
}
const { size = "sm" } = Astro.props;
const { social } = siteConfig;

const links = [
  { href: `mailto:${social.email}`, label: "Email", icon: "mail" as const, external: false },
  social.linkedin && { href: social.linkedin, label: "LinkedIn", icon: "linkedin" as const, external: true },
  social.github && { href: social.github, label: "GitHub", icon: "github" as const, external: true },
  social.googleScholar && {
    href: social.googleScholar,
    label: "Google Scholar",
    icon: "scholar" as const,
    external: true,
  },
].filter(Boolean) as { href: string; label: string; icon: "mail" | "linkedin" | "github" | "scholar"; external: boolean }[];

const iconClass = size === "lg" ? "h-6 w-6" : "h-5 w-5";
const boxClass = size === "lg" ? "h-11 w-11" : "h-9 w-9";
---

<ul class="flex items-center gap-2" aria-label="Contact and profiles">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          title={link.label}
          class={`${boxClass} inline-flex items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-accent hover:text-accent`}
          {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          <Icon name={link.icon} class={iconClass} />
        </a>
      </li>
    ))
  }
</ul>
