---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Page not found" variant="page">
  <section class="container-page flex min-h-[60vh] flex-col items-start justify-center py-24">
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-ink">Off the map.</h1>
    <p class="mt-4 max-w-xl text-muted">
      This page doesn't exist — it may have moved when the portfolio was updated.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent hover:opacity-90"
    >
      <Icon name="arrow-left" class="h-4 w-4" /> Back home
    </a>
  </section>
</BaseLayout>
